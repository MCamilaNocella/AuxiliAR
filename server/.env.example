# Copy to .env (same folder) and fill in. .env is not committed.

# Model provider for Auxi's chat: nvidia (default) or openrouter
# AI_PROVIDER=nvidia

# NVIDIA: free API key at https://build.nvidia.com (any model of the catalog)
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: true lets the model think before answering (better, much slower)
# AI_REASONING=false
