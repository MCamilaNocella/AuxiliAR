{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource.schema.json",
  "title": "Archivo de recursos de AuxiliAR",
  "description": "Estructura de cada archivo de lines/. Los valores permitidos de los campos con x-taxonomy están en taxonomy.json; las reglas que cruzan campos (ids únicos, verificación, fechas) las revisa client/scripts/resources-validate.mjs.",
  "type": "object",
  "required": ["resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Fecha AAAA-MM-DD."
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Hora HH:mm, de 24 horas."
    },
    "coverage": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "description": "Dónde sirve: todo el país, una región o área, una provincia o un municipio.",
      "properties": {
        "level": { "type": "string", "x-taxonomy": "coverageLevels" },
        "provinces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "x-taxonomy": "provinces" }
        },
        "areas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "x-taxonomy": "areas" }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "hours": {
      "type": ["object", "null"],
      "required": ["open24h"],
      "additionalProperties": false,
      "description": "null = no se sabe. Nunca se completa con 24 h por omisión.",
      "properties": {
        "open24h": { "type": "boolean" },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["days", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "0 = domingo … 6 = sábado (igual que Date.getDay).",
                "items": { "type": "integer", "minimum": 0, "maximum": 6 }
              },
              "from": { "$ref": "#/$defs/time" },
              "to": { "$ref": "#/$defs/time" }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "contact": {
      "type": "object",
      "required": ["type", "dial", "display"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "x-taxonomy": "contactTypes" },
        "dial": {
          "type": "string",
          "pattern": "^\\+?[0-9]{3,15}$",
          "description": "Solo dígitos, con + al principio si es internacional. Es lo que se marca (tel:) y con lo que se comparan los números."
        },
        "display": { "type": "string", "minLength": 1, "description": "Cómo se escribe en pantalla, por ejemplo con guiones." },
        "label": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/coverage", "description": "Alcance propio de este contacto, si difiere del del recurso." },
        "hours": { "$ref": "#/$defs/hours", "description": "Horario propio de este contacto, si difiere del del recurso." }
      }
    },
    "address": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "locality": { "type": "string", "minLength": 1 },
        "province": { "type": "string", "x-taxonomy": "provinces" },
        "postalCode": { "type": "string", "minLength": 1 }
      }
    },
    "coordinates": {
      "type": ["object", "null"],
      "required": ["lat", "lng", "precision"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "type": "string", "enum": ["exact", "approximate"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["organization"],
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "minLength": 1, "description": "Organismo que publica el dato." },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "description": "Solo status verified, con nextReviewDue sin vencer, se muestra a las personas.",
      "properties": {
        "status": { "type": "string", "x-taxonomy": "verificationStatuses" },
        "verifiedAt": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "verifiedBy": { "type": ["string", "null"], "description": "Quién verificó (iniciales o rol)." },
        "nextReviewDue": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }], "description": "Desde este día, el dato deja de mostrarse hasta que se vuelva a verificar." },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "name", "kind", "contacts", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80, "description": "Identificador estable. No se reutiliza ni se cambia." },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1, "description": "Para botones." },
        "kind": { "type": "string", "x-taxonomy": "kinds" },
        "description": { "type": "string", "minLength": 1 },
        "whenToUse": { "type": "string", "minLength": 1, "description": "Para qué sirve, en una frase." },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "x-taxonomy": "categories" }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "section"],
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string", "x-taxonomy": "categories" },
              "section": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          }
        },
        "contacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contact" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "hours": { "$ref": "#/$defs/hours" },
        "cost": { "type": "string", "x-taxonomy": "costs" },
        "costNote": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "audience": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "x-taxonomy": "audiences" }
        },
        "address": { "$ref": "#/$defs/address" },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "source": { "$ref": "#/$defs/source" },
        "verification": { "$ref": "#/$defs/verification" },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Otros nombres con los que la gente lo busca." },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emergencyBarOrder": { "type": "integer", "minimum": 1, "description": "Lugar en la barra de emergencias; sin valor, no aparece." }
          }
        }
      }
    }
  }
}
